{
  "name": "@reperes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "dbmate --env-file ../../.env -d migrations --no-dump-schema up",
    "rollback": "dbmate --env-file ../../.env -d migrations --no-dump-schema down",
    "seed": "tsx --env-file=../../.env seed/run.ts",
    "types": "kysely-codegen --env-file=../../.env --dialect postgres --out-file src/types.generated.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "kysely": "^0.28.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/pg": "^8.11.10",
    "dbmate": "^2.28.0",
    "kysely-codegen": "^0.18.0",
    "tsx": "^4.19.0",
    "typescript": "5.7.3",
    "vitest": "^3.0.0"
  }
}
